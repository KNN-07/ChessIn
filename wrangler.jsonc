{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chessin",
  "main": "./deploy/cloudflare/worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "./.cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
